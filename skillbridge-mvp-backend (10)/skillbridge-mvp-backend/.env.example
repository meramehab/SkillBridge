PORT=5000
MONGODB_URI=mongodb://localhost:27017/skillbridge_mvp
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Payment (Escrow - Paymob) - MVP: الـ escrow القديم لسه بيشتغل بوضع mock
PAYMOB_API_KEY=your_paymob_api_key_here
PAYMENT_MODE=mock

# Paymob (دفع حقيقي - Intention API)
PAYMOB_SECRET_KEY=your_paymob_secret_key_here
PAYMOB_PUBLIC_KEY=your_paymob_public_key_here
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret_here
PAYMOB_INTEGRATION_ID=your_paymob_integration_id_here
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_CHECKOUT_URL=https://accept.paymob.com/unifiedcheckout/
PAYMOB_WEBHOOK_URL=http://localhost:5000/api/payments/paymob/webhook
PAYMOB_REDIRECT_URL=http://localhost:5173/payment-result

# فودافون كاش (تحويل يدوي + تأكيد إدارة)
VODAFONE_CASH_NUMBER=01095343491

# File Upload
UPLOAD_DIR=uploads

# Gemini AI (تحليل CV الحقيقي)
# لو الـ key ده فاضي أو مش موجود، هيفضل يشتغل بس endpoint الـ Rule-Based القديم (/api/ai/cv/analyze)
GEMINI_API_KEY=your_gemini_api_key_here
# اسم الموديل
GEMINI_CV_MODEL=gemini-3.5-flash
